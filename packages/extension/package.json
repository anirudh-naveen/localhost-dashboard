{
  "name": "@ld/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build-firefox.mjs && node scripts/build-safari.mjs",
    "dev": "vite build --watch --mode development",
    "safari:project": "sh scripts/safari-project.sh",
    "package:chrome": "npm run build && node scripts/package-chrome.mjs"
  },
  "dependencies": {
    "@ld/shared": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.2"
  }
}
